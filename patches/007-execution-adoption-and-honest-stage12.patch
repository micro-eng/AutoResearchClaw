+            {"registered": ["NoWidening", "DivergenceConditionedWidener"], "scored": ["NoWidening"]},
+        )
+        assert status["any_proposed_method_scored"] is False
+        gap = _describe_plan_gap(status)
+        assert gap is not None and "proposed method" in gap
